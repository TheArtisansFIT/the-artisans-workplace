# For MongoDB Atlas, replace this with the connection string shown in Atlas.
# For local development, start a MongoDB server on localhost:27017.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=splitnest

# Replace this with a long random value outside local development.
SECRET_KEY=replace-this-local-development-secret
SEED_DEMO_USER=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
